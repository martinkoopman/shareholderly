# Copy this file to `.env` and fill in your values. .env is gitignored.

# Anthropic Claude API key for LLM-based extraction of proxy text.
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Identifier sent in the User-Agent header to EDGAR. SEC requires this and
# may block requests without a contact email. Format: "Name email@domain".
SEC_USER_AGENT=
